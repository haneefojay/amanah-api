# Planned configuration (B0.2). Values here are placeholders, never real secrets.
# Copy to .env for local development. The service must fail fast if a required value is missing.

APP_ENV=development                # development | staging | production
DATABASE_URL=postgresql+asyncpg://amanah:amanah@localhost:5432/amanah
TEST_DATABASE_URL=postgresql+asyncpg://amanah:amanah@localhost:5432/amanah_test

# Browsers allowed to call the API with credentials (comma separated)
CORS_ORIGINS=http://localhost:3000

# Sessions (ADR-011)
SESSION_COOKIE_NAME=amanah_session
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Object storage, MinIO through the S3 API (ADR-013)
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET_PUBLIC=amanah-public
S3_BUCKET_PRIVATE=amanah-private

# Paystack, test mode only (spec D3)
PAYSTACK_SECRET_KEY=sk_test_change-me
PAYSTACK_WEBHOOK_SECRET=change-me

# Reservation time to live in minutes (spec D6)
RESERVATION_TTL_MINUTES=15
