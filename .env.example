# Placeholders only, never real secrets. Copy to .env for local development.
# Read today: APP_ENV, LOG_LEVEL, DATABASE_URL (required), CORS_ORIGINS, and TEST_DATABASE_URL (tests).
# The rest is planned for later roadmap items and is ignored for now.

APP_ENV=development                # development | staging | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
DATABASE_URL=postgresql+asyncpg://amanah@localhost:5432/amanah
TEST_DATABASE_URL=postgresql+asyncpg://amanah@localhost:5432/amanah_test

# Browsers allowed to call the API with credentials (comma separated)
CORS_ORIGINS=http://localhost:3000

# Sessions (ADR-011)
SESSION_COOKIE_NAME=amanah_session
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Object storage, MinIO through the S3 API (ADR-013)
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio-local-user
S3_SECRET_KEY=minio-local-secret
S3_BUCKET_PUBLIC=amanah-public
S3_BUCKET_PRIVATE=amanah-private

# Paystack, test mode only (spec D3)
PAYSTACK_SECRET_KEY=sk_test_change-me
PAYSTACK_WEBHOOK_SECRET=change-me

# Reservation time to live in minutes (spec D6)
RESERVATION_TTL_MINUTES=15
